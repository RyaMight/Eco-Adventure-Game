[sub_resource type="GDScript" id="GDScript_rimpq"]
script/source = "extends StaticBody2D

var tarik_radius = 40  # Sesuaikan jarak tarikan

func _physics_process(delta):
	var semua_sampah = get_tree().get_nodes_in_group(\"sampah_anorganik\")
	for sampah in semua_sampah:
		var jarak = position.distance_to(sampah.position)
		if jarak < tarik_radius:
			sampah.position += (position - sampah.position) * delta * 3
			if jarak < 10:
				sampah.take_damage(10)


func _on_deteksi_area_exited(area: Area2D) -> void:
	pass # Replace with function body.
"

